{
  "displayName": "Cloud Run API - p95 latency high",
  "combiner": "OR",
  "enabled": true,
  "documentation": {
    "content": "p95 request latency is high on backend Cloud Run service.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "API p95 latency > 3s for 5m",
      "conditionThreshold": {
        "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"medical-cost-api\" AND metric.type=\"run.googleapis.com/request_latencies\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 3000,
        "duration": "300s",
        "trigger": {
          "count": 1
        },
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_MAX",
            "groupByFields": [
              "resource.labels.service_name"
            ]
          }
        ]
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  },
  "notificationChannels": [
    "projects/test1-493607/notificationChannels/14742599308437223410"
  ]
}
